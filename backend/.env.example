# =============================================================================
# 书房管理系统 - 环境变量配置模板
# =============================================================================
# 使用说明：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 根据实际情况修改各配置项
#   3. 生产环境中务必修改 SECRET_KEY 和 NFC_ENCRYPTION_KEY
#   4. 豆瓣同步功能需要配置 DOUBAN_COOKIE
#
# 配置优先级（由高到低）：
#   1. 环境变量
#   2. .env 文件
#   3. 代码中的默认值
#
# 注意：DOUBAN_COOKIE 也可通过 /api/config/cookie 接口动态管理，
#       运行时修改会自动加密并持久化到 app_settings.json。
# =============================================================================

# ==================== 应用基础配置 ====================
# 应用名称，用于文档标题和前端展示
APP_NAME=书房管理系统

# 应用版本号，遵循语义化版本规范
APP_VERSION=2.0.0

# 调试模式：true=开启（返回详细错误和堆栈），false=关闭（生产模式）
DEBUG=false

# 应用密钥，用于 JWT 签名和 Cookie 加密派生（生产环境务必修改！）
SECRET_KEY=change-me-to-a-random-secret-key

# 服务监听地址，0.0.0.0 表示监听所有网络接口
HOST=0.0.0.0

# 服务监听端口
PORT=8000

# ==================== 跨域安全配置 ====================
# 允许跨域请求的来源，多个用英文逗号分隔
# 开发环境示例：http://localhost:5173,http://localhost:3000
# 生产环境应限制为实际前端域名
CORS_ORIGINS=http://localhost:5173

# ==================== 数据库配置 ====================
# 数据库连接 URL
# SQLite 开发环境：sqlite+aiosqlite:///./bookshelf.db
# PostgreSQL 生产环境：postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./bookshelf.db

# 数据库连接池大小（仅 PostgreSQL 等非 SQLite 数据库生效）
DATABASE_POOL_SIZE=5

# SQL 语句回显开关：true=打印所有 SQL 语句（仅调试时开启）
DATABASE_ECHO=false

# ==================== 豆瓣数据源配置 ====================
# 豆瓣登录后的 Cookie 字符串（用于爬虫模拟已登录状态）
# 可通过浏览器开发者工具登录豆瓣后复制，或通过 /api/config/cookie 接口设置
# 留空则豆瓣同步功能不可用
DOUBAN_COOKIE=

# 豆瓣爬虫使用的 User-Agent（模拟 Chrome 浏览器访问）
DOUBAN_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# 豆瓣请求间隔（秒），范围 0.5~10.0，避免请求过于频繁被封禁
DOUBAN_REQUEST_DELAY=3.0

# 豆瓣请求失败最大重试次数，范围 1~10
DOUBAN_MAX_RETRIES=3

# 豆瓣请求超时时间（秒），范围 5~120
DOUBAN_TIMEOUT=30

# ==================== NFC 安全配置 ====================
# NFC 标签数据 HMAC 加密密钥（生产环境务必修改！）
# 与 NFC_SALT 共同用于生成消息认证码，验证标签数据完整性
NFC_ENCRYPTION_KEY=change-me-to-a-random-nfc-key

# NFC HMAC 盐值，增加哈希碰撞难度
NFC_SALT=nfc-salt-change-me

# ==================== 图片缓存配置 ====================
# 是否启用图书封面图片本地缓存（建议开启，减少对豆瓣 CDN 的请求）
IMAGE_CACHE_ENABLED=true

# 图片缓存目录路径（相对于 backend/ 目录）
IMAGE_CACHE_DIR=./cache/images

# 图片缓存有效期（秒），默认 604800 = 7 天
# 也可使用字符串格式：'7d'=7天, '1w'=1周
IMAGE_CACHE_MAX_AGE=604800

# ==================== 批量导入限制 ====================
# 导入文件最大大小（字节），默认 20971520 = 20MB
IMPORT_MAX_FILE_SIZE=20971520

# 单次导入最大行数限制（超过此行数将拒绝导入）
IMPORT_MAX_ROWS=5000

# ==================== 日志配置 ====================
# 日志级别：TRACE / DEBUG / INFO / SUCCESS / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# 日志文件路径（相对于 backend/ 目录）
LOG_FILE=./logs/app.log

# 日志格式（loguru 格式语法）
# 可用变量：{time} {level} {name} {function} {line} {message} {exception}
LOG_FORMAT={time:YYYY-MM-DD HH:mm:ss.SSS} | {level: <8} | {name}:{function}:{line} | {message}

# 日志文件轮转大小，支持格式：'10 MB'、'1 day'、'00:00'、'1 week'
LOG_ROTATION=10 MB

# 日志文件保留时间，支持格式：'7 days'、'1 week'、'30 days'
LOG_RETENTION=7 days

# 是否在异常日志中包含变量诊断信息（开发环境建议开启）
LOG_DIAGNOSE=true

# 是否在错误日志中包含完整堆栈回溯
LOG_BACKTRACE=true

# 是否使用消息队列进行多进程安全写入（生产环境建议开启）
LOG_ENQUEUE=true

# ==================== 备份配置 ====================
# 备份文件存储目录（相对于 backend/ 目录）
BACKUP_DIR=./backups

# 是否启用自动定时备份（true=启用，false=禁用）
BACKUP_AUTO_ENABLED=true

# 自动备份间隔（小时），范围 1~168
BACKUP_AUTO_INTERVAL_HOURS=24

# 本地最大保留备份文件数，超出自动清理旧文件（范围 1~365）
BACKUP_MAX_LOCAL_COPIES=30

# ==================== WebDAV 云同步配置 ====================
# 是否启用 WebDAV 云同步备份（true=启用，false=禁用）
WEBDAV_ENABLED=false

# WebDAV 服务器地址，如 https://webdav.example.com/remote.php/dav/files/user/
WEBDAV_URL=

# WebDAV 认证用户名
WEBDAV_USERNAME=

# WebDAV 认证密码
WEBDAV_PASSWORD=

# WebDAV 远程备份目录路径
WEBDAV_REMOTE_PATH=/backups/

# WebDAV 请求超时时间（秒），范围 5~120
WEBDAV_TIMEOUT=30
