# =============================================================================
# 书房管理系统 (NFC Books Manager) — Git 忽略规则
# =============================================================================
# 总则:仓库只追踪「主体代码 + 文档 + 配置模板」,所有运行时数据、缓存、构建
#       产物、密钥、临时文件一律忽略。
# =============================================================================

# ═══════════════════════════════════════════════════════════════════════════
# 一、运行时数据(最关键 — 这些目录不应进入仓库)
# ═══════════════════════════════════════════════════════════════════════════

# PostgreSQL 数据目录(由 docker-compose 挂载,绝对不能上传)
/pgdata/
pgdata/

# SQLite 数据库文件
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
backend/bookshelf.*

# 备份产物(整库快照 / 加密备份)
/backups/
backend/backups/
*.backup
*.bak.gz
*.dump
*.sql.gz

# 用户上传的封面与 NeDB 导入图片
backend/app/uploads/
backend/uploads/
uploads/

# 封面图片代理缓存(7 天有效, 启动后自动生成)
backend/app/cache/
backend/cache/
cache/images/

# n8n 工作流运行时数据(只保留导出的 .json 工作流定义,不留运行实例)
n8n/data/
n8n/.n8n/

# ═══════════════════════════════════════════════════════════════════════════
# 二、日志
# ═══════════════════════════════════════════════════════════════════════════
*.log
logs/
backend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ═══════════════════════════════════════════════════════════════════════════
# 三、密钥 / 凭证 / 本地配置
# ═══════════════════════════════════════════════════════════════════════════

# Python / 通用 .env(保留 .env.example 模板)
.env
.env.local
.env.*.local
*.env.bak
!.env.example
!frontend/.env.development
!frontend/.env.production

# 应用动态配置(运行时由 /api/config/cookie 等接口写入)
app_settings.json
backend/app_settings.json

# 各类凭证/令牌(本次重构发现的安全隐患, 全部明确禁止)
git令牌.txt
*token*.txt
*credential*
.git-credentials
.netrc
*.pem
*.key
*.crt
id_rsa*
id_ed25519*

# ═══════════════════════════════════════════════════════════════════════════
# 四、Python 构建/缓存产物
# ═══════════════════════════════════════════════════════════════════════════
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyo
*.pyd
*.egg
*.egg-info/
.eggs/
*.manifest
*.spec

# Python 工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/

# Python 测试与覆盖率
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.cache/
nosetests.xml

# Python 虚拟环境
venv/
.venv/
env/
.env/
ENV/

# Python 打包
build/
dist/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# ═══════════════════════════════════════════════════════════════════════════
# 五、Node / 前端构建产物
# ═══════════════════════════════════════════════════════════════════════════
node_modules/
.npm
.pnpm-store/
.pnpm-debug.log*
.yarn/
.yarn-integrity

# 前端构建输出
frontend/dist/
frontend/.vite/
.next/
.nuxt/
.output/
.parcel-cache/
.turbo/
.svelte-kit/

# Storybook
storybook-static/
frontend/storybook-static/

# 前端测试与类型缓存
frontend/coverage/
*.tsbuildinfo

# ═══════════════════════════════════════════════════════════════════════════
# 六、IDE / 编辑器
# ═══════════════════════════════════════════════════════════════════════════
.vscode/
!.vscode/settings.json.example
.idea/
*.iml
*.swp
*.swo
*~
.project
.classpath
.settings/

# AI 编辑器本地配置
.claude/
.codex/
.cursor/
.aider*
.windsurfrules
.clinerules/

# ═══════════════════════════════════════════════════════════════════════════
# 七、操作系统垃圾
# ═══════════════════════════════════════════════════════════════════════════
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
.AppleDouble
.LSOverride
Icon?
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# ═══════════════════════════════════════════════════════════════════════════
# 八、临时文件
# ═══════════════════════════════════════════════════════════════════════════
*.tmp
*.temp
*.bak
*.swp
tmp/
temp/
.tmp/
*.orig
*.rej

# ═══════════════════════════════════════════════════════════════════════════
# 九、Docker 运行时
# ═══════════════════════════════════════════════════════════════════════════
.docker/
docker-volumes/

# ═══════════════════════════════════════════════════════════════════════════
# 十、项目特定(本仓库历史遗留)
# ═══════════════════════════════════════════════════════════════════════════
ManageBooksMac/        # 旧版客户端目录
.backups               # 旧版备份目录
backend/test_api.py    # 本地手动测试脚本,非 pytest 用例

# ═══════════════════════════════════════════════════════════════════════════
# 反向白名单(强制纳入即使匹配上面规则)
# ═══════════════════════════════════════════════════════════════════════════
!.env.example
!.gitkeep
!.github/
!docs/**/*.png
!frontend/public/**
!frontend/.env.development
!frontend/.env.production
